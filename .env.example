# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection (injected at runtime by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Safaricom Daraja M-PESA API (Optional: leave blank for clearly labeled sandbox/pending mode)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="522522"
MPESA_PASSKEY=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""
MPESA_B2C_SHORTCODE=""
MPESA_CALLBACK_URL=""
MPESA_ENV="sandbox"
